GEMINI_API_KEY=your_gemini_api_key_here
# Fallback AI when Gemini fails: Groq (gsk_...) or xAI Grok key
GROK_API_KEY=your_groq_or_grok_api_key_here
# Optional: news with images from https://gnews.io (free, ~100 requests/day).
# Without it, news comes from Google News RSS (no images).
GNEWS_API_KEY=your_gnews_api_key_here
PORT=3000
